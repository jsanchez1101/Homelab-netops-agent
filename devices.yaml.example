# VyOS "OSPF Triangle" (see TOPOLOGY.md). Mgmt assumes 192.168.86.0/24 —
# verify with `ip route | grep default` on node1 and adjust here + configs/.
devices:
  R1:
    host: "10.99.0.11"
    device_type: "vyos"
    username: "admin"
    password: "<ROUTER_PASSWORD>"
    description: "VyOS router. Intended topology: connects to R2 and R3."
  R2:
    host: "10.99.0.12"
    device_type: "vyos"
    username: "admin"
    password: "<ROUTER_PASSWORD>"
    description: "VyOS router. Intended topology: connects to R1 and R3."
  R3:
    host: "10.99.0.13"
    device_type: "vyos"
    username: "admin"
    password: "<ROUTER_PASSWORD>"
    description: "VyOS router. Intended topology: connects to R1 and R2."
